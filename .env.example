# Environment Variables Example
# Copy this file to .env.local and fill in your values

# Database
# For local development, use SQLite:
DATABASE_URL="file:./dev.db"
# For production, use PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/database"
# Prisma Accelerate (optional, for connection pooling in production)
# PRISMA_ACCELERATE_URL="prisma+postgres://..."
# Direct database connection (for migrations)
# DIRECT_DATABASE_URL="postgres://..."

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000" # Change to your domain in production
NEXTAUTH_SECRET="" # Generate with: openssl rand -base64 32

# YouTube API
YOUTUBE_API_KEY="" # Get from Google Cloud Console
YOUTUBE_CHANNEL_ID="" # Your YouTube channel ID
YOUTUBE_CHANNEL_HANDLE="" # Your YouTube channel handle (e.g., @YourChannel)

# Stripe Payment Processing
STRIPE_SECRET_KEY="" # From Stripe Dashboard (use test keys for development)
STRIPE_WEBHOOK_SECRET="" # Set after configuring webhook endpoint
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="" # From Stripe Dashboard

# Vercel Blob Storage (optional)
BLOB_READ_WRITE_TOKEN="" # From Vercel Dashboard

# Cron Jobs
CRON_SECRET="" # Random string to secure cron endpoints

# Email Service (Resend)
RESEND_API_KEY="" # From Resend Dashboard

# Optional: Site Configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000" # Your site URL