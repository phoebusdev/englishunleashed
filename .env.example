# ============================================
# Environment Variables Template for Vercel
# ============================================
# Copy this file to .env.local for local development
# Add these variables to your Vercel project settings

# ============================================
# DATABASE (Required)
# ============================================
# For local development, use SQLite:
DATABASE_URL="file:./dev.db"

# For production, use PostgreSQL from your provider:
# DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Optional: Prisma Accelerate for connection pooling (recommended for production)
# PRISMA_ACCELERATE_URL="prisma+postgres://..."
# DIRECT_DATABASE_URL="postgres://..."

# ============================================
# AUTHENTICATION (Required)
# ============================================
# Local development:
NEXTAUTH_URL="http://localhost:3000"
# Production (use your actual domain):
# NEXTAUTH_URL="https://yourdomain.com"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ============================================
# YOUTUBE API (Required)
# ============================================
# Get from Google Cloud Console
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""
YOUTUBE_CHANNEL_HANDLE=""

# Optional: For webhook security (generate random string)
YOUTUBE_WEBHOOK_SECRET=""

# ============================================
# STRIPE PAYMENTS (Required for payments)
# ============================================
# Get from Stripe Dashboard
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ============================================
# FILE STORAGE (Required for PDF uploads)
# ============================================
# Vercel Blob Storage token
BLOB_READ_WRITE_TOKEN=""

# ============================================
# EMAIL SERVICE (Required for notifications)
# ============================================
# Resend API key
RESEND_API_KEY=""

# ============================================
# SECURITY (Required for production)
# ============================================
# Random string for cron job authentication
CRON_SECRET=""

# ============================================
# OPTIONAL SERVICES
# ============================================
# Admin notifications
ADMIN_EMAIL=""

# Site URL (optional, defaults to NEXTAUTH_URL)
NEXT_PUBLIC_SITE_URL=""