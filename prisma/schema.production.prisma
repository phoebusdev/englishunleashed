// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model - extensible for future features
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?   // Optional for guest users initially
  name            String?
  isAdmin         Boolean   @default(false)
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  orders          Order[]
  quizAttempts    QuizAttempt[]
  sessions        Session[]
  passwordResets  PasswordReset[]
  
  // Future expansion fields (unused for now)
  subscriptionId  String?
  subscriptionEnd DateTime?
  preferences     String?   @db.Text // Store user preferences as JSON string
}

// Session management for NextAuth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Password reset tokens
model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Pack model - the main content unit
model Pack {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  price       Int      // Store in cents
  hasQuiz     Boolean  @default(false)
  hasPdf      Boolean  @default(false)
  videoId     String?  // YouTube video ID
  pdfUrl      String?  @db.Text // Vercel Blob storage URL
  level       String?  // A1, A2, B1, B2, C1, C2
  order       Int      @default(0) // For sorting
  active      Boolean  @default(true)
  metadata    String?  @db.Text // Flexible field for future features (JSON string)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  quiz        Quiz?
  orders      OrderPack[]
  products    Product[]
}

// Product model for bundling packs
model Product {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  price       Int      // Store in cents
  type        ProductType @default(PACK)
  active      Boolean  @default(true)
  stripePaymentLinkId String? // Stripe Payment Link ID
  stripePaymentLinkUrl String? @db.Text // Direct URL to payment
  metadata    String?  @db.Text // Flexible field for future features (JSON string)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  packs       Pack[]
  orders      Order[]
  promoCodes  PromoCodeProduct[]
}

enum ProductType {
  PACK
  BUNDLE
  SUBSCRIPTION
}

// Order model - purchase records
model Order {
  id                String   @id @default(cuid())
  userId            String?  // Null for guest checkouts
  guestEmail        String?  // For guest checkouts
  productId         String
  amount            Int      // Amount in cents
  status            OrderStatus @default(PENDING)
  stripeSessionId   String?  @unique // For tracking payment sessions
  stripePaymentId   String?  // For successful payments
  downloadToken     String?  @unique // For secure download links
  downloadExpiry    DateTime? // Expiry for download links
  metadata          String?  @db.Text // Store additional data as JSON
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  // Relations
  user              User?    @relation(fields: [userId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])
  packs             OrderPack[]
  downloadLogs      DownloadLog[]
}

// Junction table for Order-Pack many-to-many
model OrderPack {
  id        String   @id @default(cuid())
  orderId   String
  packId    String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pack      Pack     @relation(fields: [packId], references: [id])
  createdAt DateTime @default(now())
  
  @@unique([orderId, packId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

// Quiz system
model Quiz {
  id          String     @id @default(cuid())
  packId      String     @unique
  title       String
  description String?    @db.Text
  timeLimit   Int?       // in minutes
  passingScore Int       @default(70) // percentage
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  // Relations
  pack        Pack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  questions   Question[]
  attempts    QuizAttempt[]
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  text        String   @db.Text
  explanation String?  @db.Text // Show after answering
  order       Int      @default(0)
  points      Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     Answer[]
  userAnswers UserAnswer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  text       String   @db.Text
  isCorrect  Boolean  @default(false)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers UserAnswer[]
}

// Track quiz attempts
model QuizAttempt {
  id          String       @id @default(cuid())
  userId      String?      // Null for guest attempts
  guestId     String?      // For tracking guest attempts
  quizId      String
  score       Int          // Percentage score
  timeSpent   Int?         // in seconds
  completed   Boolean      @default(false)
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  
  // Relations
  user        User?        @relation(fields: [userId], references: [id])
  quiz        Quiz         @relation(fields: [quizId], references: [id])
  userAnswers UserAnswer[]
  
  @@index([userId])
  @@index([guestId])
}

// Track individual answers in quiz attempts
model UserAnswer {
  id          String      @id @default(cuid())
  attemptId   String
  questionId  String
  answerId    String?     // Null if unanswered
  isCorrect   Boolean     @default(false)
  answeredAt  DateTime    @default(now())
  
  // Relations
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question    Question    @relation(fields: [questionId], references: [id])
  answer      Answer?     @relation(fields: [answerId], references: [id])
  
  @@unique([attemptId, questionId])
}

// Download tracking
model DownloadLog {
  id         String   @id @default(cuid())
  orderId    String
  packId     String?  // Which pack was downloaded
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  
  // Relations
  order      Order    @relation(fields: [orderId], references: [id])
}

// Email queue for async processing
model EmailQueue {
  id         String      @id @default(cuid())
  to         String
  subject    String
  template   String      // Template name
  data       String      @db.Text // JSON data for template
  status     EmailStatus @default(PENDING)
  attempts   Int         @default(0)
  error      String?     @db.Text
  sentAt     DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// Analytics (optional, for tracking)
model PageView {
  id         String   @id @default(cuid())
  sessionId  String?
  path       String
  referrer   String?  @db.Text
  userAgent  String?  @db.Text
  ipAddress  String?
  userId     String?  // If logged in
  createdAt  DateTime @default(now())
  
  @@index([sessionId])
  @@index([path])
  @@index([createdAt])
}

// Promo codes
model PromoCode {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?  @db.Text
  discountType   DiscountType
  discountValue  Int      // Percentage (0-100) or fixed amount in cents
  usageLimit     Int?     // Null for unlimited
  usageCount     Int      @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  products       PromoCodeProduct[]
}

// Junction table for PromoCode-Product many-to-many
model PromoCodeProduct {
  id           String    @id @default(cuid())
  promoCodeId  String
  productId    String
  promoCode    PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([promoCodeId, productId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}