// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User model - extensible for future features
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  password        String?   // Optional for guest users initially
  name            String?
  isAdmin         Boolean   @default(false)
  emailVerified   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  orders          Order[]
  quizAttempts    QuizAttempt[]
  sessions        Session[]
  passwordResets  PasswordReset[]
  
  // Future expansion fields (unused for now)
  subscriptionId  String?
  subscriptionEnd DateTime?
  preferences     String?   // Store user preferences as JSON string
}

// Session management for NextAuth
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Password reset tokens
model PasswordReset {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  
  user      User     @relation(fields: [userId], references: [id])
  
  @@index([userId])
}

// Product model - flexible for packs, subscriptions, etc
model Product {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Int      // Store in cents
  type        ProductType @default(PACK)
  active      Boolean  @default(true)
  stripePaymentLinkId String? // Stripe Payment Link ID
  stripePaymentLinkUrl String? // Direct URL to payment
  metadata    String?  // Flexible field for future features (JSON string)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  packs       Pack[]
  orders      Order[]
  promoCodes  PromoCodeProduct[]
}

enum ProductType {
  PACK
  SUBSCRIPTION
  BUNDLE
}

// Pack model - links video, PDF, and quiz
model Pack {
  id          String   @id @default(cuid())
  productId   String
  title       String
  description String?
  videoId     String?  // YouTube video ID - nullable until video added
  videoUrl    String?  // Full URL for flexibility
  pdfUrl      String?  // S3/Vercel Blob URL - nullable until uploaded
  hasPdf      Boolean  @default(false)
  hasQuiz     Boolean  @default(false)
  order       Int      @default(0) // For sorting
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  product     Product  @relation(fields: [productId], references: [id])
  quiz        Quiz?
}

// Order model - tracks purchases
model Order {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  amount        Int      // Amount paid in cents
  status        OrderStatus @default(PENDING)
  stripeId      String?  // Stripe payment intent ID
  promoCodeId   String?
  downloadExpiry DateTime? // For guest users
  notifiedPdfReady Boolean @default(false) // Track if user was notified when PDF is ready
  notifiedQuizReady Boolean @default(false) // Track if user was notified when quiz is ready
  metadata      String?  // Store additional order info (JSON string)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  user          User     @relation(fields: [userId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  promoCode     PromoCode? @relation(fields: [promoCodeId], references: [id])
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Promo code model
model PromoCode {
  id            String   @id @default(cuid())
  code          String   @unique
  description   String?
  discountType  DiscountType
  discountValue Int      // Percentage (0-100) or fixed amount in cents
  maxUses       Int?
  usedCount     Int      @default(0)
  validFrom     DateTime @default(now())
  validUntil    DateTime?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  orders        Order[]
  products      PromoCodeProduct[] // Specific products this code applies to
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// Junction table for promo codes and products
model PromoCodeProduct {
  promoCodeId String
  productId   String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])
  
  @@id([promoCodeId, productId])
}

// Quiz model
model Quiz {
  id          String   @id @default(cuid())
  packId      String   @unique
  title       String
  description String?
  passingScore Int?    // Optional passing score
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  pack        Pack     @relation(fields: [packId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]
}

// Question model
model Question {
  id          String   @id @default(cuid())
  quizId      String
  text        String
  options     String   // Array of answer options (JSON string)
  correctAnswer String
  order       Int      @default(0)
  explanation String?  // Optional explanation for the answer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

// Quiz attempt tracking
model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  answers     String   // Store user's answers (JSON string)
  completedAt DateTime @default(now())
  
  // Relations
  user        User     @relation(fields: [userId], references: [id])
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  
  @@index([userId, quizId])
}

// Future expansion models (commented out for now)
// model Subscription {
//   id        String   @id @default(cuid())
//   userId    String
//   status    String
//   // ... subscription fields
// }

// Analytics Models
model PageView {
  id          String   @id @default(cuid())
  pathname    String
  referrer    String?
  
  // User info
  userId      String?
  sessionId   String
  
  // Device info
  userAgent   String?
  browser     String?
  os          String?
  device      String?  // mobile, tablet, desktop
  
  // Location info
  country     String?
  city        String?
  region      String?
  
  // Timestamps
  createdAt   DateTime @default(now())
  duration    Int?     // Time spent on page in seconds
  
  @@index([pathname, createdAt])
  @@index([sessionId])
  @@index([userId])
}

model AnalyticsSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  userId      String?
  
  // Session info
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  pageViews   Int      @default(0)
  duration    Int?     // Total session duration in seconds
  
  // Entry info
  entryPage   String?
  exitPage    String?
  
  // Traffic source
  source      String?  // google, direct, social, etc
  medium      String?  // organic, cpc, referral, etc
  campaign    String?
  
  @@index([userId])
  @@index([startedAt])
}

// Download Analytics model
model DownloadLog {
  id          String   @id @default(cuid())
  userId      String?  // Nullable for guest downloads
  orderId     String
  packId      String
  
  // Request info
  ipAddress   String?
  userAgent   String?
  referrer    String?
  
  // Download info
  fileType    String   // pdf, video, etc
  fileName    String?
  fileSize    Int?    // In bytes
  
  // Timestamps
  createdAt   DateTime @default(now())
  
  @@index([userId])
  @@index([orderId])
  @@index([packId])
  @@index([createdAt])
}

// Email Queue model for async email processing
model EmailQueue {
  id          String   @id @default(cuid())
  to          String   // Recipient email
  from        String?  // Sender email (defaults to system email)
  subject     String
  html        String   // HTML content
  text        String?  // Plain text fallback
  status      EmailStatus @default(PENDING)
  priority    Int      @default(0) // Higher priority processed first
  attempts    Int      @default(0)
  lastError   String?
  metadata    String?  // JSON string for additional data
  
  // Timestamps
  createdAt   DateTime @default(now())
  scheduledFor DateTime @default(now()) // When to send
  sentAt      DateTime?
  
  @@index([status, scheduledFor])
  @@index([priority, createdAt])
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}